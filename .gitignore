# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Pengecualian: sertifikat self-signed khusus test transport TTE lokal.
# Bukan secret — lihat src/testing/fixtures/tte-lokal/README.md.
!src/testing/fixtures/tte-lokal/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the template, ignore the rest)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local runtime storage (uploads, generated files)
/storage
# local agent/tool artifacts
.claude/
.playwright-mcp/
/uploads

# local test/agent caches
/.vitest/
**/node_modules/

# python cache dari skill pihak ketiga
__pycache__/
*.pyc
