# ============================================================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   PowerShell : Copy-Item .env.example .env
#   bash       : cp .env.example .env
# JANGAN pernah meng-commit file `.env` yang berisi nilai asli.
# ============================================================================

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
NODE_ENV=development

# URL publik aplikasi (dipakai untuk absolute URL, OAuth callback, dsb.)
APP_URL=http://localhost:3000

# Nama aplikasi. Berawalan NEXT_PUBLIC_ sehingga AMAN dipakai di sisi client.
# Di-inline saat build — ubah nilainya memerlukan build ulang.
NEXT_PUBLIC_APP_NAME=Sistem Informasi Desa

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB)
# ---------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Database harus sudah dibuat sebelum migrasi dijalankan.
DATABASE_URL=mysql://root:@127.0.0.1:3306/desa_dev

# ---------------------------------------------------------------------------
# Integration test (hanya untuk database uji disposable)
# ---------------------------------------------------------------------------
# `npm run test:integration` MEMBUAT database, menjalankan migration, dan
# menulis fixture. Jangan pernah mengarahkannya ke database berisi data nyata.
# Guard menolak NODE_ENV selain test, host non-loopback, nama database di luar
# allowlist desa_test / desa_test_<suffix>, serta query string/fragment pada URL
# (mis. ?socketPath=... dapat mengubah tujuan koneksi).
# TEST_DATABASE_URL=mysql://uji:uji@127.0.0.1:3306/desa_test
# Setel 1 HANYA setelah memastikan database tersebut disposable.
# TEST_DATABASE_ACK=1

# ---------------------------------------------------------------------------
# Autentikasi (better-auth)
# ---------------------------------------------------------------------------
# WAJIB diganti. Buat nilai acak (minimal 32 karakter), contoh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000

# Aktifkan hanya bila aplikasi berada di belakang reverse proxy/platform yang
# menimpa header IP klien (X-Real-IP, X-Forwarded-For, CF-Connecting-IP).
# Nilai false membuat header tersebut diabaikan agar tidak dapat dipalsukan.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Email (opsional — Resend untuk email keluar; webhook untuk email masuk)
# ---------------------------------------------------------------------------
# Isi bersama: jika API key disetel, alamat pengirim yang diverifikasi wajib.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=SID Desa <no-reply@domain-desa.id>
# Rahasia HMAC webhook email (minimal 32 karakter acak).
# EMAIL_WEBHOOK_TOKEN=buat-token-acak-minimal-32-karakter
# Provider harus mengirim header:
#   X-Email-Webhook-Timestamp: Unix timestamp (detik)
#   X-Email-Webhook-Id: ID event unik (8-128 karakter)
#   X-Email-Webhook-Signature: hex HMAC-SHA256
# Signature = HMAC-SHA256(EMAIL_WEBHOOK_TOKEN,
#   "<timestamp>.<event-id>.<normalized-host>.<raw-request-body>"
# Host dinormalisasi lowercase, tanpa port dan trailing dot; harus sama dengan
# Host yang digunakan provider saat membuat signature.
# Timestamp ditolak bila selisihnya lebih dari 5 menit; event ID yang sama
# hanya diterima sekali dalam 10 menit (disimpan di tabel rate_limit_entries).
# Payload JSON: { alamat, subjek?, isi, tanggal? }. Tenant hanya dari Host;
# X-Forwarded-Host tidak digunakan untuk memilih desa.
# WhatsApp memakai Baileys (WhatsApp Web), bukan API HTTP berbayar.
# Jalankan aplikasi sebagai proses Node persisten (VPS/Docker/PM2), bukan serverless.
# Saat pertama dijalankan, QR dicetak di log server; pindai lewat
# WhatsApp > Perangkat tertaut > Tautkan perangkat. Sesi tersimpan di folder
# di bawah (default storage/whatsapp-auth, sudah di-.gitignore).
# WHATSAPP_AUTH_DIR=storage/whatsapp-auth

# ---------------------------------------------------------------------------
# TTE / BSrE (opsional)
# ---------------------------------------------------------------------------
# Mode/API/username/NIK dapat diatur per desa (tabel tte_config); halaman
# admin belum tersedia di repo ini. Passphrase HANYA dibaca dari environment
# ini dan tidak pernah disimpan di database.
# TTE_MODE=nonaktif
# TTE_API=https://tte.example.go.id
# TTE_USERNAME=desa
# TTE_NIK=3201010101010001
# TTE_PASSWORD=
# Allowlist provider yang DIKELOLA PLATFORM (tenant tidak dapat menambah).
# Daftar host dipisah koma: `host` (port 443) atau `host:port`. Exact match,
# tanpa wildcard/suffix. Kosong atau tidak sah = SEMUA provider TTE ditolak.
# TTE_ALLOWED_HOSTS=tte.example.go.id
# Verifikasi sertifikat TLS selalu aktif dan tidak dapat dimatikan lewat env.

# ---------------------------------------------------------------------------
# API eksternal (opsional)
# ---------------------------------------------------------------------------
# Endpoint /api/eksternal/* memakai header X-API-Key: <kunci>.
# Kunci dibuat lewat endpoint admin POST /api/pengaturan/api-key dan disimpan
# sebagai hash; nilai asli hanya ditampilkan sekali saat pembuatan.

# ---------------------------------------------------------------------------
# Multi-desa (opsional)
# ---------------------------------------------------------------------------
# Domain induk wildcard: <slug desa>.<DESA_BASE_DOMAIN> otomatis menunjuk desa.
# Kosongkan bila hanya memakai domain persis dari tabel village_domains.
# DESA_BASE_DOMAIN=desa.id
